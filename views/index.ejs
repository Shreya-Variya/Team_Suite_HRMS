<% layout("/layouts/boilerplate") %>

<body>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <h1>All-in-One HR Platform</h1>
      <p>
        Simplify company management, streamline admin control, and scale your
        workforce effortlessly with Team Suite.
      </p>

      <div class="hero-stats">
        <div>
          <h3>100+</h3>
          <span>Companies</span>
        </div>
        <div>
          <h3>1K+</h3>
          <span>Employees</span>
        </div>
        <div>
          <h3>99.9%</h3>
          <span>Uptime</span>
        </div>
      </div>
    </div>

    <div class="hero-right">
      <img src="/image/Team Suite Circle.png" alt="Team Suite" />
    </div>
  </section>

  <!-- FEATURES -->

  <section class="features">
    <div class="feature">
      <h3>🏢 Company Management</h3>
      <p>Create and manage organizations efficiently</p>
    </div>
    <div class="feature">
      <h3>👤 Admin Control</h3>
      <p>Assign admins with full control access</p>
    </div>
    <div class="feature">
      <h3>👥 Employee Management</h3>
      <p>Easily manage employee records, roles, and lifecycle in one place</p>
    </div>
  </section>

  <!-- ACTION CARDS -->

  <section class="actions">
    <div class="card">
      <h2>Register Company</h2>
      <p>Start by adding a company to your system</p>
      <a href="/company" class="btn">Create Company</a>
    </div>

    <div class="card">
      <h2>Create Admin</h2>
      <p>Assign an administrator to manage operations</p>
      <a href="/admin" class="btn">Create Admin</a>
    </div>
  </section>
</body>
